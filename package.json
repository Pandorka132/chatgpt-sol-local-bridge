{
  "name": "chatgpt-sol-local-bridge",
  "version": "1.0.0",
  "description": "Production-grade, cross-platform 44-tool MCP bridge from ChatGPT to a local workstation over OpenAI Secure MCP Tunnel.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mingrath/chatgpt-sol-local-bridge.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:all": "node scripts/start-all.mjs",
    "dev": "node --watch src/server.js",
    "doctor": "node src/doctor.js",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "docx": "^9.14.0",
    "dotenv": "^18.0.9",
    "exceljs": "4.4.1-prerelease.0",
    "express": "^5.3.0",
    "ipaddr.js": "^2.5.0",
    "mammoth": "1.13.0",
    "undici": "8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "globals": "^16.5.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "files": [
    "src",
    "scripts",
    "docs",
    "launchd",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "chatgpt",
    "mcp",
    "secure-mcp-tunnel",
    "codex",
    "automation",
    "cross-platform"
  ]
}
